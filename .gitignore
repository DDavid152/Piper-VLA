/data/
/datasets/
/recordings/
/captures/
/outputs/
/checkpoints/
/models/
/weights/
/artifacts/
/runs/
/wandb/
/mlruns/
**/checkpoints/
*.safetensors
optimizer_state.*
rng_state.*
scheduler_state.*
training_step.*

# Download and tool caches
/.cache/
/.huggingface/
.ipynb_checkpoints/

# Python/build artifacts
__pycache__/
*.py[cod]
*.egg-info/
/.venv/
/venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Local temporary files and environment secrets
/tmp/
/temp/
*.tmp
*.swp
.env
.env.*
!.env.example

# Editor and OS files
.vscode/
.idea/
.DS_Store
